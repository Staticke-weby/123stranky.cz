  { "q": "Do jakých měst a obcí dojíždíte?", "a": "Naše pobočka je v Tuřanech u Slaného. Pravidelně dojíždíme do Slaného, Kladna, Kralup nad Vltavou, Rakovníka, Loun, Nového Strašecí, Velvar, Stochova, Libušína, Zlonic, Smečna a Lán a do desítek menších obcí v jejich okolí." },
  { "q": "Stavíte weby i mimo tento region?", "a": "Ano. Oborové weby a weby pro klienty z jiných částí republiky běžně řešíme online — přes telefon, e-mail a videohovory." },
  { "q": "Musím kvůli schůzce někam dojíždět?", "a": "Ne. Můžeme se sejít u nás v Tuřanech u Slaného, u vás v provozovně, nebo celý projekt vyřídit online." },
  { "q": "Kolik web stojí?", "a": "Stavba webu začíná na 9 990 Kč bez DPH. Platí se polovina při objednání a polovina po dodání webu." },
  { "q": "Za jak dlouho bude web hotový?", "a": "Běžný web zvládneme do sedmi pracovních dnů od chvíle, kdy máme texty a fotky." }
] %}
{% include "faq-strip.njk" %}

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>Pojďme postavit web, který vás v regionu zviditelní</h2>
      <p>Napište nám pár vět o svém projektu. Ozveme se obvykle do 24 hodin s návrhem dalšího postupu.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light btn-lg" href="/kontakt/">Nezávazně poptat</a>
      <a class="btn btn-ghost-light btn-lg" href="{{ site.emailHref }}" data-umami-event="kontakt-email" data-umami-event-misto="cta">Napsat e-mail</a>
    </div>
  </div>
</section>
