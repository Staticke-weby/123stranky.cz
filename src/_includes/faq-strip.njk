{% from "icon.njk" import icon %}
<section class="section{% if faqSoft %} section--soft{% endif %}">
  <div class="container faq-wrap">
    <div class="section-head section-head--left">
      <p class="eyebrow">{{ faqEyebrow or "Časté dotazy" }}</p>
      <h2>{{ faqTitle }}</h2>
    </div>
    <div class="faq">
      {% for f in faqItems %}
      <details class="faq-item">
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
